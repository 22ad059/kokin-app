{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kokin-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kokin-app"
    }
  ],
  "routes": [
    {
      "pattern": "kokin.aoisakana.com",
      "custom_domain": true
    }
  ],
  // オンライン対戦の部屋サーバー（worker/GameRoom.ts）
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      },
      // 効果検証実験の記録（worker/ExperimentLog.ts）
      {
        "name": "EXPERIMENT_LOG",
        "class_name": "ExperimentLog"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ExperimentLog"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
